{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KoosReplay",
  "version": "0.1.0",
  "identifier": "io.koosreplay.desktop",

  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "KoosReplay",
        "width": 1200,
        "height": 760,
        "minWidth": 980,
        "minHeight": 650,
        "resizable": true
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,

    "targets": [
      "nsis",
      "msi"
    ],

    "icon": [
      "icons/icon.ico"
    ],

    "resources": [
      "bin/ffmpeg.exe"
    ]
  }
}
